# Environment variables & secrets
.env
.env.*
!.env.example

# Runtime cache data (kept in the repo via `git add -f` in the workflows)
posted_tweets.json
posted_reddit.json
proxy_health.json
pending_reddit.json
# Created only when Reddit dead-post retraction is enabled; force-added by the workflow.
posted_messages.json

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Local logs
*.log

# Generated maintenance/validation scratch (never committed; the monitors write
# their run reports under RUNNER_TEMP, and these are the local equivalents plus
# the isolated compiler/tool virtualenvs the lock jobs build).
/.compiler/
/.tools/
run-report*.json
persistence*.json
compiler-requirements*.txt

# Ruff cache for the pinned lint gate (the tool version itself is pinned in
# requirements-dev.txt; only its cache is generated).
.ruff_cache/

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# IDE & editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
