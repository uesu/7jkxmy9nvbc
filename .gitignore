# Environment variables & secrets
.env
.env.*
!.env.example

# Runtime cache data (kept in the repo via `git add -f` in the workflows)
posted_tweets.json
posted_reddit.json
proxy_health.json
pending_reddit.json
# Reddit retraction and durable long-body delivery state; force-added by the workflow.
posted_messages.json
# Same-directory atomic-save scratch files (may remain after process termination).
.posted-messages-*
# Local run-result record for the Reddit monitor (workflow summary source)
reddit_run_result.json

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Local logs
*.log

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# IDE & editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
