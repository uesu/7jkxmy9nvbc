{
  "schema_version": 1,
  "contract": "news-express-maintenance/1",
  "project": "news-reddit-production",
  "description": "Project profile consumed by .github/scripts/{maintenance,ci,python_version_bump,render_run_summary}.py. The helpers are shared verbatim across the News development repository and both News production repositories; only this profile differs per repository.",
  "runtime": {
    "python_pin_file": ".python-version",
    "requirements_input": "requirements.in",
    "requirements_lock": "requirements.txt",
    "dev_requirements_input": "requirements-dev.in",
    "dev_requirements_lock": "requirements-dev.txt",
    "lock_compiler": {
      "pip": "26.1.1",
      "pip_tools": "7.5.3"
    },
    "compile_command": "python -m piptools compile --generate-hashes --allow-unsafe --resolver=backtracking --strip-extras --output-file=requirements.txt requirements.in",
    "dev_compile_command": "python -m piptools compile --generate-hashes --allow-unsafe --resolver=backtracking --strip-extras --constraint=requirements.txt --output-file=requirements-dev.txt requirements-dev.in",
    "install_command": "python -m pip install --require-hashes --only-binary=:all: -r requirements.txt",
    "wheel_only": true,
    "setup_python_source": "python-version-file"
  },
  "test_glob": "tests/test_*.py",
  "source_globs": [
    "testing area",
    "tests",
    ".github/scripts"
  ],
  "compile_command_check": "python -m compileall -q \"testing area\" tests",
  "profiles": {
    "development": {
      "description": "News-Express development repository: ships README/AGENTS/docs.",
      "tests": [
        "python tests/test_smoke.py",
        "python tests/test_reddit_signals.py",
        "python tests/test_twitter_media.py",
        "python tests/test_maintenance.py",
        "python tests/test_run_summary.py",
        "python tests/test_configuration_contract.py"
      ],
      "optional_docs": [
        "README.md",
        "AGENTS.md",
        "docs/PYTHON_RUNTIME.md",
        "docs/DEPENDABOT.md",
        "docs/CI_SMOKE.md",
        "docs/MAINTENANCE.md"
      ],
      "optional_checks": [
        "docs-links"
      ]
    },
    "production": {
      "description": "Manually deployed production copy: runtime code, automation and tests only. No README, AGENTS or docs/ directory is present and none may be required.",
      "tests": [
        "python tests/test_smoke.py",
        "python tests/test_reddit_signals.py",
        "python tests/test_twitter_media.py",
        "python tests/test_maintenance.py",
        "python tests/test_run_summary.py",
        "python tests/test_configuration_contract.py"
      ],
      "optional_docs": [],
      "optional_checks": []
    }
  },
  "checks": {
    "final_gate": "maintenance-ci",
    "required": [
      "application",
      "maintenance",
      "lockfiles",
      "workflows"
    ],
    "advisory": [],
    "tools": {
      "yaml_parser": "pyyaml 6.0.3",
      "linter": "ruff 0.17.0",
      "workflow_linter": "actionlint (advisory in this profile; YAML parse + pin/permission checks are mandatory)"
    },
    "lint_paths": [
      ".github/scripts/maintenance.py",
      ".github/scripts/ci.py",
      ".github/scripts/python_version_bump.py",
      ".github/scripts/render_run_summary.py",
      "tests/test_maintenance.py",
      "tests/test_run_summary.py",
      "tests/test_configuration_contract.py"
    ],
    "lint_debt_exempt": [
      "testing area",
      "tests/test_smoke.py",
      "tests/test_reddit_signals.py",
      "tests/test_twitter_media.py",
      ".github/scripts/merge_monitor_caches.py"
    ]
  },
  "python_updates": {
    "manifest_url": "https://raw.githubusercontent.com/actions/python-versions/main/versions-manifest.json",
    "platform": "linux",
    "architecture": "x64",
    "soak_days_default": 30,
    "auto_merge_variable": "AUTO_MERGE_PYTHON_BUMP",
    "auto_merge_value": "yes",
    "max_series_step": "minor",
    "proposal_branch_prefix": "chore/python-",
    "publisher": "python_version_bump.yml#publish",
    "proposer_self_merge": false
  },
  "dependency_updates": {
    "auto_merge_variable": "AUTO_MERGE_DEPENDABOT",
    "auto_merge_value": "yes",
    "lock_files": [
      "requirements.txt",
      "requirements-dev.txt"
    ],
    "lock_inputs": [
      "requirements.in",
      "requirements-dev.in"
    ],
    "allowed_routine_paths": [
      "requirements.txt",
      "requirements-dev.txt"
    ],
    "review_required_paths": [
      ".github/workflows",
      ".github/scripts",
      ".github/maintenance.json",
      "testing area",
      "tests"
    ]
  },
  "merge_controller": {
    "workflow": ".github/workflows/maintenance_merge.yml",
    "trusted_updaters": [
      {
        "login": "dependabot[bot]",
        "branch_prefix": "dependabot/",
        "kind": "dependencies"
      },
      {
        "login": "arena-bump-bot",
        "branch_prefix": "chore/python-",
        "kind": "python"
      }
    ],
    "allowed_merge_methods": [
      "squash",
      "merge"
    ],
    "verify_merged_response": true
  },
  "monitor_reporting": {
    "schema_version": 1,
    "env_report_path": "RUN_REPORT_PATH",
    "env_persistence_path": "RUN_PERSISTENCE_PATH",
    "renderer": ".github/scripts/render_run_summary.py"
  },
  "copy_manifest": {
    "description": "Deterministic production-copy manifest. Both News production repositories are compared on these hashes only; never on whole-repository SHAs and never on cache contents.",
    "include": [
      ".python-version",
      "requirements.in",
      "requirements.txt",
      "requirements-dev.in",
      "requirements-dev.txt",
      "ruff.toml",
      ".env.example",
      ".gitignore",
      ".github/dependabot.yml",
      ".github/maintenance.json",
      ".github/scripts/maintenance.py",
      ".github/scripts/ci.py",
      ".github/scripts/python_version_bump.py",
      ".github/scripts/render_run_summary.py",
      ".github/scripts/merge_monitor_caches.py",
      ".github/workflows/ci.yml",
      ".github/workflows/maintenance_merge.yml",
      ".github/workflows/python_version_bump.yml",
      ".github/workflows/reddit_monitor.yml",
      ".github/workflows/twitter_monitor.yml",
      "testing area/reddit_main.py",
      "testing area/reddit_main_v2_embedez.py",
      "testing area/reddit_main_v3.py",
      "testing area/reddit_proxy.py",
      "testing area/run_report.py",
      "testing area/reddit_signals.py",
      "testing area/twitter_proxy.py",
      "testing area/twitter_v1.py",
      "testing area/twitter_v2_button_outside.py",
      "testing area/twitter_v3.py",
      "testing area/video_diag.py",
      "tests/fixtures/posted_cards.py",
      "tests/fixtures/maintenance",
      "tests/test_reddit_signals.py",
      "tests/test_smoke.py",
      "tests/test_twitter_media.py",
      "tests/test_maintenance.py",
      "tests/test_run_summary.py",
      "tests/test_configuration_contract.py"
    ],
    "exclude_globs": [
      "README.md",
      "AGENTS.md",
      "docs/**",
      "PRIVACY_POLICY.md",
      "TERMS_OF_SERVICE.md",
      ".github/workflows/maintenance_review.yml",
      ".github/workflows/freedit_probe.yml",
      ".github/scripts/maintenance_review_audit.py",
      ".github/scripts/probe_*.py",
      "tests/test_freedit_probe.py",
      "tests/test_other_instances_probe.py"
    ],
    "never_touch": [
      "pending_reddit.json",
      "posted_reddit.json",
      "posted_tweets.json",
      "proxy_health.json",
      "posted_messages.json"
    ]
  }
}
