{
  "schema_version": 1,
  "project": "news-express",
  "python": {
    "pin_file": ".python-version",
    "manifest_url": "https://raw.githubusercontent.com/actions/python-versions/main/versions-manifest.json",
    "soak_days_default": 30,
    "rewrite_files": [
      ".python-version"
    ]
  },
  "profiles": {
    "development": {
      "optional_docs": true,
      "require_docs": true
    },
    "production": {
      "optional_docs": true,
      "require_docs": false
    }
  },
  "mandatory_check_names": [
    "application",
    "maintenance",
    "lock-consistency",
    "workflow-security",
    "maintenance-ci"
  ],
  "final_gate": "maintenance-ci",
  "ci_workflow_name": "CI \u2014 syntax + offline smoke test",
  "test_commands": {
    "compile": [
      "python",
      "-m",
      "compileall",
      "-q",
      "testing area",
      "tests",
      ".github/scripts"
    ],
    "application": [
      [
        "python",
        "tests/test_smoke.py"
      ],
      [
        "python",
        "tests/test_reddit_signals.py"
      ],
      [
        "python",
        "tests/test_twitter_media.py"
      ],
      [
        "python",
        "tests/test_crosspost_video.py"
      ]
    ],
    "maintenance": [
      [
        "python",
        "tests/test_maintenance.py"
      ],
      [
        "python",
        "tests/test_run_summary.py"
      ],
      [
        "python",
        "tests/test_configuration_contract.py"
      ]
    ]
  },
  "ruff": {
    "version": "0.13.2",
    "paths": [
      ".github/scripts",
      "testing area/run_report.py",
      "tests/test_maintenance.py",
      "tests/test_run_summary.py",
      "tests/test_configuration_contract.py"
    ]
  },
  "actionlint": {
    "version": "1.7.12",
    "url": "https://github.com/rhysd/actionlint/releases/download/v1.7.12/actionlint_1.7.12_linux_amd64.tar.gz",
    "sha256": "8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8"
  },
  "updater_identities": {
    "dependabot": {
      "login": "dependabot[bot]",
      "auto_merge_var": "AUTO_MERGE_DEPENDABOT"
    },
    "python_bump": {
      "login": "github-actions[bot]",
      "auto_merge_var": "AUTO_MERGE_PYTHON_BUMP",
      "branch_prefix": "chore/python-",
      "allowed_files": [
        ".python-version"
      ]
    }
  },
  "human_review_labels": [
    "review-required",
    "do-not-merge",
    "hold",
    "changes-requested"
  ],
  "allowed_merge_method": "squash",
  "fallback_merge_methods": [
    "merge"
  ],
  "compile_command": [
    "python",
    "-m",
    "piptools",
    "compile",
    "--generate-hashes",
    "--allow-unsafe",
    "--resolver=backtracking",
    "--strip-extras",
    "--output-file=requirements.txt",
    "requirements.in"
  ],
  "dev_compile_command": [
    "python",
    "-m",
    "piptools",
    "compile",
    "--generate-hashes",
    "--allow-unsafe",
    "--resolver=backtracking",
    "--strip-extras",
    "--output-file=requirements-dev.txt",
    "requirements-dev.in"
  ],
  "custom_compile_command": "python -m piptools compile --generate-hashes --allow-unsafe --resolver=backtracking --strip-extras --output-file=requirements.txt requirements.in",
  "install_command": [
    "python",
    "-m",
    "pip",
    "install",
    "--require-hashes",
    "--only-binary=:all:",
    "-r",
    "requirements.txt"
  ],
  "runtime_files": [
    ".python-version",
    "requirements.in",
    "requirements.txt",
    "requirements-dev.in",
    "requirements-dev.txt",
    ".github/maintenance.json",
    ".github/scripts/maintenance.py",
    ".github/scripts/python_version_bump.py",
    ".github/scripts/ci.py",
    ".github/scripts/render_run_summary.py",
    ".github/scripts/merge_monitor_caches.py",
    ".github/workflows/ci.yml",
    ".github/workflows/python_version_bump.yml",
    ".github/workflows/maintenance_merge.yml",
    ".github/workflows/reddit_monitor.yml",
    ".github/workflows/twitter_monitor.yml",
    ".github/dependabot.yml",
    ".env.example",
    ".gitignore",
    "testing area/run_report.py",
    "testing area/reddit_main.py",
    "testing area/reddit_main_v2_embedez.py",
    "testing area/reddit_main_v3.py",
    "testing area/reddit_proxy.py",
    "testing area/reddit_signals.py",
    "testing area/twitter_v1.py",
    "testing area/twitter_v2_button_outside.py",
    "testing area/twitter_v3.py",
    "testing area/twitter_proxy.py",
    "testing area/video_diag.py",
    "tests/test_smoke.py",
    "tests/test_reddit_signals.py",
    "tests/test_twitter_media.py",
    "tests/test_maintenance.py",
    "tests/test_run_summary.py",
    "tests/test_configuration_contract.py",
    "tests/test_crosspost_video.py",
    "tests/fixtures/posted_cards.py"
  ],
  "production_copy_exclude": [
    "README.md",
    "AGENTS.md",
    "PRIVACY_POLICY.md",
    "TERMS_OF_SERVICE.md",
    "docs",
    "posted_reddit.json",
    "posted_tweets.json",
    "pending_reddit.json",
    "proxy_health.json",
    "posted_messages.json"
  ],
  "optional_docs": [
    "README.md",
    "AGENTS.md",
    "docs/MAINTENANCE.md",
    "docs/PYTHON_RUNTIME.md",
    "docs/DEPENDABOT.md",
    "docs/CI_SMOKE.md",
    "docs/MAINTENANCE.md"
  ],
  "dependabot_allowed_files": [
    "requirements.in",
    "requirements.txt",
    "requirements-dev.in",
    "requirements-dev.txt",
    ".github/workflows/"
  ],
  "dependabot_allowed_directories": [
    ".github/workflows/"
  ],
  "check_producers": {
    "application": {
      "workflow": ".github/workflows/ci.yml",
      "job": "application"
    },
    "maintenance": {
      "workflow": ".github/workflows/ci.yml",
      "job": "maintenance"
    },
    "lock-consistency": {
      "workflow": ".github/workflows/ci.yml",
      "job": "lock-consistency"
    },
    "workflow-security": {
      "workflow": ".github/workflows/ci.yml",
      "job": "workflow-security"
    },
    "maintenance-ci": {
      "workflow": ".github/workflows/ci.yml",
      "job": "maintenance-ci"
    }
  },
  "security_evidence": {
    "mode": "disabled",
    "required": [],
    "candidates": [
      "code-scanning",
      "secret-scanning"
    ],
    "note": "mode=disabled is a deliberate, recorded decision, not an empty list standing in for one: with no kinds named the controller reports security-evidence-not-required, and an omitted or unrecognised mode fails closed as security-evidence-unconfigured instead. Reason: this repository runs no code or secret scanning - there is no CodeQL workflow and no default setup - and the merge workflow's GITHUB_TOKEN holds actions/checks/contents/pull-requests/statuses but not security-events, so neither endpoint is reachable. Requiring a scan that is not running would defer every auto-merge with no way to satisfy it, and enabling a scanner is a security-tooling change outside this PR's authorisation. The retrieval, pagination, head-scope and fail-closed behaviour are fully implemented; move a name from candidates to required (and add security-events: read) to enforce it."
  },
  "publication_evidence": {
    "mode": "disabled",
    "proposer_workflow": ".github/workflows/python_version_bump.yml",
    "proposal_files": [
      ".python-version"
    ],
    "commit_identity": "github-actions[bot]",
    "commit_name": "github-actions[bot]",
    "commit_email": "41898282+github-actions[bot]@users.noreply.github.com",
    "note": "mode=disabled is a deliberate, recorded decision, not an omission: with no mode the controller fails closed as publication-evidence-unconfigured, and mode=disabled blocks the python-bump auto-merge lane as publication-lane-blocked rather than reading as satisfied. Dependabot proposals are unaffected (publication-not-applicable). Reason: this repository's python_version_bump publish job pushes with BUMP_PAT and commits as github-actions[bot], but it does not yet emit the bound validation and publication notices that verify_publication_record joins on, so there is no evidence to require. Declaring required here would block every python-bump proposal on notices that are never produced, which misstates the cause. The collection, binding and fail-closed behaviour are fully implemented; add notice emission to the publish job (the --emit-publication pattern) and move mode to required to enforce it. PR title and body are never evidence."
  }
}
