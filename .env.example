# ------------------------------------------------------------------
# Local testing template — copy to .env and fill in your values.
# (GitHub Actions uses repository Secrets/Variables instead — see README.)
# ------------------------------------------------------------------

# Optional catch-all fallback webhook (only used for accounts/subs without their own secret)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Comma-separated list of X (Twitter) handles to track
ACCOUNTS=TYPEII_EN,PomPom_HonkaiSR,Wuthering_Waves,HonkaiNA,Ananta_EN

# One webhook per account (rule: WEBHOOK_ + account name uppercased)
WEBHOOK_TYPEII_EN=https://discord.com/api/webhooks/...
WEBHOOK_POMPOM_HONKAISR=https://discord.com/api/webhooks/...
WEBHOOK_WUTHERING_WAVES=https://discord.com/api/webhooks/...
WEBHOOK_HONKAINA=https://discord.com/api/webhooks/...
WEBHOOK_ANANTA_EN=https://discord.com/api/webhooks/...

# Comma-separated subreddits to track
SUBREDDITS=Zenlesszonezeroleaks_,Genshin_Impact_Leaks,HonkaiStarRail_leaks,WutheringWavesLeaks,HonkaiNexusAnimaLeaks,AnantaLeaks

# One webhook per subreddit (rule: WEBHOOK_REDDIT_ + sub name uppercased)
WEBHOOK_REDDIT_ZENLESSZONEZEROLEAKS_=https://discord.com/api/webhooks/...
WEBHOOK_REDDIT_GENSHIN_IMPACT_LEAKS=https://discord.com/api/webhooks/...
WEBHOOK_REDDIT_HONKAISTARRAIL_LEAKS=https://discord.com/api/webhooks/...
WEBHOOK_REDDIT_WUTHERINGWAVESLEAKS=https://discord.com/api/webhooks/...
WEBHOOK_REDDIT_HONKAINEXUSANIMALEAKS=https://discord.com/api/webhooks/...
WEBHOOK_REDDIT_ANANTALEAKS=https://discord.com/api/webhooks/...

# Optional (V1 only): embed mirror host — redditez.com | embeddit.deltandy.me | vxreddit.com
REDDIT_MIRROR=redditez.com

# Reddit V2 only (from your embedez.com dashboard)
EMBEDEZ_API_KEY=ez_...

# Nitter / Redlib RSS token (optional repo secret NITTER_RSS_TOKEN):
# Unlocks token-gated nitter.miningtcup.me (X) and redlib.miningtcup.me (Reddit V3).
NITTER_RSS_TOKEN=

# Reddit feed token — RECOMMENDED (V1 + V2, and V3's RSS rate tier).
# (Round 31: V3's FULL-MODE .json attempt now runs only with an OAuth app,
# or REDDIT_JSON_PROBE=force — see the switch below.)
# Anonymous Reddit RSS from datacenter IPs is limited to ~1 request/minute per
# IP since June 2026; the token (below) moves requests to the logged-in rate
# tier. Get it: old.reddit.com -> Preferences -> Feeds -> copy the "?feed=..."
# value from any feed link (the token itself, without "?feed=").
# On GitHub this is the REDDIT_FEED_TOKEN secret.
REDDIT_FEED_TOKEN=

# ------------------------------------------------------------------
# Reddit V3 (round 12) — ALL OPTIONAL; defaults shown in comments.
# (GitHub: set as repo Variables, not Secrets — none of these are secrets.)
# ------------------------------------------------------------------

# 1 = also try to PLAY youtube links (seaof.glass proxy, adds probe time).
# 0 (default) = thumbnail + animated starwardspark3 button only.
# YOUTUBE_MEDIA_EMBED=0

# 0 = hide the "💬 OP comment" line (FULL MODE only). 1 (default) = show it.
# REDDIT_OP_COMMENT=1

# 0 = don't create the per-card Discohook share-link preview. 1 (default) = on.
# DISCOHOOK_PREVIEW=1

# Seconds between feed-token .json attempts (anonymous tier ~1 req/min).
# Only relevant while the probe runs — see REDDIT_JSON_PROBE below.
# FEEDTOKEN_JSON_STAGGER=65

# Round 31: when V3's feed-token .json FULL-MODE probe runs (65 s wait per
# run with new posts, then a datacenter-IP 403 while no OAuth app exists):
#   auto (default; unset = auto) = only when BOTH REDDIT_CLIENT_ID and
#        REDDIT_CLIENT_SECRET are set (a real app exists);
#   force = always try once per run with new posts (legacy behavior);
#   off   = never.
# REDDIT_JSON_PROBE=auto

# Round 32: seconds between re-checks of approval-queued posts ("Post is
# awaiting moderator approval.") and transient sources-down misses; default
# 300 (5 min) — a newly-approved post then posts on the next cron tick
# instead of waiting up to 30 min. (Removed posts are never re-checked at
# all — they re-enter via RSS if a mod restores them.)
# APPROVAL_RECHECK_SECONDS=300

# Round 30: seconds between live re-checks of media-waiting/partial-gallery
# entries in pending_reddit.json. Approval and transient-source entries use
# APPROVAL_RECHECK_SECONDS instead; default 1800 (30 min).
# PENDING_RECHECK_SECONDS=1800

# Round 34: dedup-cache retention + flood cap (the 2026-09-28 AnantaLeaks
# re-post loop — the old single 500-key global cap evicted keys
# ALPHABETICALLY, so the first-tracked sub lost keys on every save).
# Newest keys kept PER subreddit / PER X account; 10 000 global backstop;
# one run posts at most 25 new posts (the newest; the rest retry next run
# inside the 48 h window).
# MAX_CACHE_SIZE_PER_SUB=250
# MAX_CACHE_SIZE_PER_ACCOUNT=250
# MAX_CACHE_SIZE_TOTAL=10000
# MAX_POSTS_PER_RUN=25

# Round 35: every NEW post is checked against Reddit's own NSFW markers
# (over_18 + the "nsfw" thumbnail sentinel) in one batched Arctic Shift
# lookup. Flagged posts are held for the 48 h pending window and are not
# posted. TEST_POST_ID rebuilds bypass the gate. Round 42 CHANGED the
# failure mode: an unreadable lookup now fails CLOSED (see below).
# Optional comma-separated author names or post IDs that bypass the gate:
# NSFW_ALLOWLIST=

# Round 36: settle window; fresh posts are re-evaluated next run. 0 = off.
# POST_SETTLE_SECONDS=300
# Round 36: exact same-media URL duplicate gate per sub. 0 = off.
# DUP_MEDIA_GATE=1
# Round 37/38d: positive queue-comment + native zero-comment queue gate.
# 0 disables it. The window is both the six-hour fail-open cap and the
# conservative tail margin for the /new-listing check; there is no third
# mod-queue Variable.
# MOD_QUEUE_GATE=1
# MOD_QUEUE_WINDOW_SECONDS=21600

# ---------------------------------------------------------------------------
# Rounds 42-45 (2026-10-01): faster delivery + a stricter safety gate.
# Every value below is OPTIONAL. Unset = the default shown, which is the
# shipped behaviour; you do not need to set any of these.
# ---------------------------------------------------------------------------

# Round 42 — EVIDENCE-BASED SETTLE (the latency fix).
# A post confirmed present in the subreddit's public /new listing is, by
# definition, neither in Reddit's spam filter nor in the mod queue, so it
# only waits out a short AutoModerator buffer instead of the full window.
# A post that is NOT confirmed (or when the listing cannot be read) keeps
# the unchanged 300 s wait, so the fast path can never apply to a filtered,
# queued or removed post.
#   confirmed in /new  -> POST_SETTLE_VERIFIED_SECONDS (60 s)
#   not confirmed      -> POST_SETTLE_SECONDS          (300 s, unchanged)
# Set POST_SETTLE_VERIFIED_SECONDS=300 to reproduce the old timing exactly.
# POST_SETTLE_VERIFIED_SECONDS=60

# Round 46: grace for weak AutoModerator source-rule evidence.
# MOD_QUEUE_WEAK_GRACE_SECONDS=900

# Round 49 (Reddit) — PARALLEL PROXY DISPATCH.
# vxreddit + redditez are queried together; embeddit is held back and is
# skipped entirely when the first wave already produced a decisive answer
# (a video on a video post, or a full 20-item card). Tie-break order is
# vxreddit -> redditez -> embeddit. Empty values keep the tuned defaults.
# PROXY_WAVE_DELAY=0.5        # seconds before the 3rd service joins
# PROXY_GALLERY_GRACE=1.5     # max wait for a MORE COMPLETE gallery
# PROXY_MAX_CONCURRENCY=8     # global cap on in-flight proxy requests

# Round 13/49: V3 proxy-media controls. The proxy path is on by default;
# setting PROXY_MEDIA=0 keeps the native RSS/media fallback only. The warm-up
# post is a stable public post used to skip services that are down this run.
# PROXY_MEDIA=1
# PROXY_WARMUP_POST=HonkaiStarRail_leaks/1whbjbh
# EMBEDDIT_INSTANCE=https://embeddit.deltandy.me
# YOUTUBE_LINK_MESSAGE=1       # post a second bare YouTube link after the card

# Round 47 (X / Twitter) — MEDIA SELF-HEAL + the real video size limit.
# Discord's media proxy sometimes returns a gallery tile with width/height 0
# and an empty content_type (it minted a proxy_url but never finished
# fetching the asset) — the client then shows "Image failed to load". An
# edit makes Discord re-resolve it, so the monitor re-sends the identical
# payload as an edit, after the posting loop, for affected messages only.
# MEDIA_HEAL=off                 # disable the heal pass (default: on)
# MEDIA_HEAL_DELAY_SECONDS=45    # wait before each re-edit (30-60 is sane)
# MEDIA_HEAL_ATTEMPTS=2          # max re-edits per message
# Round 46b: the /new listing is resolved from every source at once. An
# API-backed (redlib HTML) listing wins the moment it lands, because only it
# can prove a post was released from the moderator queue; Reddit's own
# /new.rss is kept as a fallback and is held back for the grace below so a
# merely-slow redlib fleet does not cost the fast settle path. The whole
# listing step is bounded by the timeout, after which the monitor proceeds
# with whatever it has (and fails open, as before).
# LISTING_HTML_GRACE_SECONDS=2
# LISTING_TIMEOUT_SECONDS=8

# Round 42 — NSFW GATE NOW FAILS CLOSED.
# The gate runs BEFORE any Discord message, embed, thumbnail or media work,
# and checks the post (over_18), the community (over18) and, for crossposts,
# the source post and source community. Missing/malformed/unfetchable
# metadata is held as nsfw_unknown and re-checked — never read as safe.
#   NSFW_FAIL_OPEN=1        restores the pre-round-42 fail-open behaviour.
#   NSFW_REQUIRE_SUBREDDIT=1 also demands a READABLE community record before
#                           posting (default off: SUBREDDITS plus the
#                           per-sub webhook map is already an allowlist).
# NSFW_FAIL_OPEN=0
# NSFW_REQUIRE_SUBREDDIT=0

# Round 45 — LIVE-PAGE NSFW FALLBACK (protects the speed win).
# Failing closed on one source has a cost: the Arctic archive lags behind
# brand-new posts, so a 2-minute-old post could be held a whole extra cron
# tick. When the archive has no record, the marker is instead read off the
# live Redlib post page (<small class="nsfw">NSFW</small>) that the run
# already fetches for the liveness check — no extra request. A spoiler badge
# is NOT NSFW. An unreadable page still fails closed.
#   0 = strict archive-only (the post is held instead).
# NSFW_PAGE_FALLBACK=1

# Round 43 — AUTHOR RE-UPLOAD GATE.
# The round-36 duplicate gate compares exact media URLs, and a re-upload
# always gets a BRAND NEW v.redd.it/i.redd.it id, so it cannot see the
# "author deletes and re-posts the same thing" pattern. This gate compares
# the (subreddit + author + normalised title) identity instead and skips a
# post already on Discord. An unknown author ([deleted]) or an empty title
# produces no identity and the gate fails open. Costs no extra request.
#   0 = off. REPOST_WINDOW_SECONDS = how far back the comparison reaches.
# REPOST_GATE=1
# REPOST_WINDOW_SECONDS=86400

# Rounds 43/44 — DEAD-POST RETRACTION. SHIPPED DISABLED.
# When a post that was already delivered later dies (author deleted it, mods
# removed it), its Discord card can be rewritten in place as a tombstone.
# It EDITS, never deletes: per Discord's Announcement Channel FAQ an edit
# updates the message in every FOLLOWING server, while a delete leaves a
# permanent "[Original Message Deleted]" note there — which matters because
# this channel is autopublished. Two independent proofs are required
# (absent from a /new listing that should still show it, AND a removal
# verdict from a live source), and the post id stays in the dedup cache, so
# a retraction can never cause a re-post.
# It is OFF by default because it costs extra requests; when enabled it runs
# AFTER the posting loop, so it still cannot delay a new post, and only then
# is wait=true added to the webhook call.
#   RETRACT_DEAD_POSTS=1 enables it. RETRACT_MODE: edit (default) | delete | off.
# RETRACT_DEAD_POSTS=0
# RETRACT_MODE=edit
# RETRACT_WINDOW_SECONDS=21600

# If you lower the cron-job.org interval below 5 minutes, match the short
# re-check interval to it so held posts are re-evaluated every tick:
#   3-minute cron -> APPROVAL_RECHECK_SECONDS=180
#   2-minute cron -> APPROVAL_RECHECK_SECONDS=120
# APPROVAL_RECHECK_SECONDS=300

# Test tools (local): rebuild one specific post, and/or log payloads only
# (no Discord post, no cache save):
# TEST_POST_ID=AnantaLeaks/1wgvcz7
# DRY_RUN=1

# Test tools (local X/Twitter): rebuild one specific tweet. An already-cached
# account_tweet-id is intentionally NOT reposted; the run logs that skip.
# TEST_TWEET_ID=Wuthering_Waves/2100555373073797461

# OPTIONAL (V3 FULL MODE, reliable): Reddit script app — reddit.com/prefs/apps
# -> "create another app" -> type "script" -> redirect http://localhost.
# 2026: new API access may require Reddit's approval form. Works without it.
# Round 31: the workflow wires these LIVE — just set the two repo secrets
# when the app exists; FULL MODE turns on with no code change, and (in auto
# mode) the feed-token .json probe above switches on as a fallback.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
